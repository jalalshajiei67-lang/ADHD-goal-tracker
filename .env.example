# Copy to .env.local for local dev; set the same values in Vercel → Project → Settings → Environment Variables.

# Login: the passphrase you type to open the app.
APP_PASSPHRASE=
# Random 32+ char strings. Generate with: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: only for `npm run test:db` against a local Supabase.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_SERVICE_ROLE_KEY=
